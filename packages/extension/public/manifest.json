{
  "manifest_version": 3,
  "name": "满天星 · 一键收藏",
  "short_name": "满天星",
  "version": "0.1.0",
  "description": "把当前页面收藏到你的满天星。数据存在你自己的 GitHub 私有仓库里，没有第三方服务器。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "收藏到满天星",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.github.com/*"],
  "commands": {
    "quick-save": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "收藏当前页面到满天星"
    }
  },
  "externally_connectable": {
    "matches": ["https://salenju.github.io/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
